{
  "name": "fluxion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "gate": "tsx scripts/gate.ts",
    "depcruise": "depcruise packages --config .dependency-cruiser.mjs",
    "depcruise:graph": "depcruise packages --config .dependency-cruiser.mjs --output-type dot | dot -T svg -o dependency-graph.svg",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build:web": "pnpm --filter @fluxion/web build",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
